# Copy to .env for local development. All values below are fake.
STUDY_ENV=local
DATABASE_URL=postgresql+asyncpg://study:study_local_pw@localhost:5432/study_league
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-local-only-not-a-real-secret
DEVICE_HASH_SALT=change-me-local-only
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]

# Rate limiting is off locally so development is not throttled. Staging and production
# refuse to boot with it disabled — see docs/architecture/SECURITY.md.
RATE_LIMIT_ENABLED=false

# Host allowlist (TrustedHostMiddleware). Empty accepts any Host, which is fine locally;
# required outside local/test.
ALLOWED_HOSTS=

# How many reverse proxies sit in front of this app. The client IP is read that many hops
# from the right of X-Forwarded-For. Leave at 0 when nothing proxies the app: a non-zero
# value with no real proxy lets callers forge their own rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# Largest accepted request body, in bytes. The biggest legitimate one is an offline sync
# batch after a long stretch without a network.
MAX_REQUEST_BYTES=2097152

# Password-reset link lifetime.
PASSWORD_RESET_TTL_MINUTES=30

# Domain for the browser refresh cookie. Leave unset for a host-only cookie.
REFRESH_COOKIE_DOMAIN=
